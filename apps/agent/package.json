{
  "name": "@kubetrail/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KubeTrail Agent SDK client with Claude/Codex providers and NDJSON pipe IPC",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "chat": "tsx src/cli.ts chat",
    "pipe": "tsx src/cli.ts pipe",
    "mcp": "tsx src/cli.ts mcp",
    "exp": "tsx src/cli.ts exp",
    "env": "tsx src/cli.ts env"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.173",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/codex-sdk": "^0.142.2",
    "zod": "^4.0.0"
  },
  "overrides": {
    "@anthropic-ai/sdk": "0.95.2",
    "hono": "^4.12.27",
    "qs": "^6.15.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18"
  }
}
