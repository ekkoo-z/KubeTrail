# Required unless your Claude Code environment is already authenticated.
KUBETRAIL_AGENT_API_KEY=

# Optional gateway/proxy endpoint. This maps to ANTHROPIC_BASE_URL.
# Example: https://llm-gateway.example.com
KUBETRAIL_AGENT_BASE_URL=

# Optional model override. Full model IDs and aliases supported by Claude Agent SDK are accepted.
KUBETRAIL_AGENT_MODEL=claude-sonnet-4-6
KUBETRAIL_AGENT_FALLBACK_MODEL=

# Optional network proxy variables. These map to HTTPS_PROXY, HTTP_PROXY, and NO_PROXY.
KUBETRAIL_AGENT_HTTPS_PROXY=
KUBETRAIL_AGENT_HTTP_PROXY=
KUBETRAIL_AGENT_NO_PROXY=

# Optional runtime tuning.
KUBETRAIL_AGENT_TIMEOUT_MS=120000
KUBETRAIL_AGENT_MAX_RETRIES=2
KUBETRAIL_AGENT_MAX_TURNS=200
KUBETRAIL_AGENT_HOST=127.0.0.1
KUBETRAIL_AGENT_PORT=18080

# Default input file. If unset, the agent tries repo-root dbus.json, then result.json.
KUBETRAIL_RESULT_PATH=

# Dangerous: sends sensitive material from local dbus/result JSON to the model when requested.
KUBETRAIL_AGENT_ALLOW_MATERIALIZE=0
